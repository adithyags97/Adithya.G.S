<div id="chat" role="dialog" aria-label="Adithya's Assistant" aria-modal="false">
 <div class="ch"><img id="hdrImg" alt=""><strong>Adithya's Assistant</strong><button id="vc" title="Voice on/off" aria-pressed="true" aria-label="Turn voice off">&#128266;</button><button id="clr" title="Clear chat">Clear</button><button id="cls" aria-label="Close chat">&#10005;</button></div>
 <div id="log" aria-live="polite"></div>
 <div id="chips"></div>
 <form class="cf" id="f"><textarea id="in" rows="1" maxlength="500" placeholder="Ask about skills, education, contact..." aria-label="Your question"></textarea><button id="send" type="submit">Send</button></form>
</div>

<script>
const WELCOME = "Hi! I'm your AI Recruiter. Ask me about my skills, projects, achievements, or experience. What would you like to explore?";
const SUGGEST = ["What are the strongest technical skills?","Tell me about a featured project","What achievements or certifications are listed?","Can I see the GitHub repository?","How can I contact Adithya?"];
const $ = id => document.getElementById(id);
const chat=$('chat'), log=$('log'), input=$('in'), sendBtn=$('send'), chips=$('chips');
let history=[], busy=false, lastText='';
try{history=JSON.parse(sessionStorage.getItem('rec_hist')||'[]')}catch(e){}
const save=()=>{try{sessionStorage.setItem('rec_hist',JSON.stringify(history.slice(-12)))}catch(e){}};
$('hdrImg').src=document.querySelector('#mascotBtn img').src;

function bubble(text,cls){const d=document.createElement('div');d.className='m '+cls;d.textContent=text;log.appendChild(d);log.scrollTop=log.scrollHeight;return d}
function render(){log.innerHTML='';bubble(WELCOME,'bot');history.forEach(h=>bubble(h.content,h.role==='user'?'user':'bot'));
 chips.innerHTML='';if(!history.length)SUGGEST.forEach(s=>{const b=document.createElement('button');b.type='button';b.textContent=s;b.onclick=()=>ask(s);chips.appendChild(b)})}
function toggle(open){if(!open)stopSpeech();chat.classList.toggle('open',open);$('mascotBtn').setAttribute('aria-expanded',open);if(open){render();setTimeout(()=>input.focus(),250)}else $('mascotBtn').focus()}
$('mascotBtn').onclick=()=>toggle(!chat.classList.contains('open'));
$('cls').onclick=()=>toggle(false);
$('clr').onclick=()=>{stopSpeech();history=[];save();render()};
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&chat.classList.contains('open'))toggle(false)});


// ---- Built-in assistant: answers only from the verified facts below. No server, no API key. ----
const FACTS={
 name:'Adithya G Shirabadagi',
 intro:"I'm Adithya G Shirabadagi, a first-semester B.E. student in Artificial Intelligence and Machine Learning (AIML) at BGSCET.",
 skills:"My skills: beginner level CAD, I have learnt Java completely, I'm currently learning C programming, and I use GitHub efficiently.",
 java:"I have completed learning Java.",
 c:"I'm currently learning C programming.",
 cad:"I'm a beginner in CAD.",
 github:"I use GitHub efficiently for my work. My repository: https://github.com/adithyags97/adithyags97.github.io",
 projects:"I don't have projects yet because I'm a first-semester student. Projects may be assigned during my degree, and I'll add them here once I build them. Meanwhile you can follow my work on GitHub: https://github.com/adithyags97/adithyags97.github.io",
 achievements:"No achievements or certifications are listed yet. I'm at the start of my degree, so this will grow over time.",
 experience:"I don't have work experience yet, since I'm a first-semester engineering student. I also have no client work so far.",
 education:"My education:\n• School: Aham Athma Vidyalaya, completed 2024\n• PUC: Ashoka Composite PU College, completed 2026\n• Degree: BGSCET, currently in 1st semester B.E. AIML",
 contact:"You can reach me here:\n• Email: adithyags97@gmail.com\n• Phone: 8310585507\n• GitHub: https://github.com/adithyags97/adithyags97.github.io",
 strongest:"My strongest area right now is Java, which I have completed learning. I'm also learning C, have beginner CAD knowledge, and work comfortably with GitHub."
};
const INTENTS=[
 ['greet',/\b(hi|hello|hey|namaste|good (morning|afternoon|evening))\b/],
 ['thanks',/\b(thanks?|thank you|great|awesome|nice)\b/],
 ['strongest',/\b(strong|strongest|best|top|main|core)\b.*\b(skill|tech|technical|area|language)|\bstrongest\b/],
 ['java',/\bjava\b/],['c',/\bc (programming|language)\b|\bc\b(?! ?\+)|\bc\+\+\b/],['cad',/\bcad\b|\bdesign software\b/],
 ['github',/\bgit ?hub|\brepo(sitory)?\b|\bcode samples?\b/],
 ['projects',/\bproject|\bportfolio work|\bbuilt\b|\bfeatured\b|\btechnolog/],
 ['achievements',/\bachievement|\bcertificat|\baward|\bhackathon|\bcourses?\b/],
 ['experience',/\bexperience|\bwork(ed|ing)?\b|\bintern|\bemploy|\bjob\b|\bclient/],
 ['education',/\beducation|\bstud(y|ies|ying|ent)|\bcollege|\bschool|\bpuc\b|\bdegree|\bbgscet|\bqualif|\bbranch|\bsemester|\bgraduat/],
 ['contact',/\bcontact|\bemail|\be-mail|\bphone|\bnumber|\bcall\b|\breach|\bhire\b|\bhiring|\bget in touch|\blinkedin|\bresume|\bcv\b/],
 ['skills',/\bskill|\bknow\b|\blanguages?\b|\bprogramming|\bcan you do|\bexpertise|\bstack\b|\btools?\b/],
 ['intro',/\bwho\b|\babout\b|\bintroduc|\btell me about|\byourself|\bname\b|\bdeveloper\b|\bAIML\b|\bai ?ml\b/]
];
const MORE={skills:'java',java:'projects',c:'projects',cad:'skills',education:'experience',experience:'projects',projects:'github',github:'contact',achievements:'education',intro:'skills',strongest:'skills'};
let lastTopic=null;
function answer(q){
 const t=q.toLowerCase();
 if(/\b(more|elaborate|go on|details?|what else|anything else|next)\b/.test(t)&&lastTopic){const n=MORE[lastTopic]||'contact';lastTopic=n;return FACTS[n]}
 for(const [k,re] of INTENTS){if(re.test(t)||(k==='c'&&/^c\??$/.test(t.trim()))){
   if(k==='greet'){return "Hi! I can tell you about my skills, education, projects, experience or how to contact me. What would you like to know?"}
   if(k==='thanks'){return "You're welcome! Ask me anything else about my skills, education or contact details."}
   lastTopic=k;return FACTS[k];}}
 return "I don't have verified information on that yet. I can tell you about my skills, education, projects, experience, achievements, or how to contact me. Which would you like?";
}

// ---- Voice: the assistant reads its answers aloud (browser speech synthesis, no server) ----
const synth=window.speechSynthesis;let voiceOn=true,voice=null;
try{voiceOn=localStorage.getItem('rec_voice')!=='off'}catch(e){}
const vc=$('vc');
function pickVoice(){if(!synth)return;const v=synth.getVoices();voice=v.find(x=>/en[-_]IN/i.test(x.lang))||v.find(x=>/^en/i.test(x.lang))||v[0]||null}
function paintVc(){vc.innerHTML=voiceOn?'&#128266;':'&#128263;';vc.setAttribute('aria-pressed',voiceOn);vc.setAttribute('aria-label',voiceOn?'Turn voice off':'Turn voice on')}
function stopSpeech(){if(synth)synth.cancel()}
function speak(t){
 if(!synth||!voiceOn)return;stopSpeech();
 const clean=t.replace(/https?:\/\/\S+/g,'my GitHub link').replace(/([\w.]+)@([\w.]+)/g,'$1 at $2').replace(/\b(\d{10})\b/g,m=>m.split('').join(' ')).replace(/[\u2022\n]+/g,'. ').replace(/\.\s*\./g,'.');
 const u=new SpeechSynthesisUtterance(clean);if(voice){u.voice=voice;u.lang=voice.lang}else u.lang='en-IN';u.rate=1;u.pitch=1.05;synth.speak(u);
}
if(!synth){vc.style.display='none'}else{pickVoice();synth.onvoiceschanged=pickVoice;paintVc();
 vc.onclick=()=>{voiceOn=!voiceOn;try{localStorage.setItem('rec_voice',voiceOn?'on':'off')}catch(e){}paintVc();if(!voiceOn)stopSpeech();else speak('Voice is on.')}}
async function ask(text,isRetry){
 text=(text||'').trim();if(!text||busy)return;
 busy=true;sendBtn.disabled=true;lastText=text;chips.innerHTML='';
 if(!isRetry)bubble(text,'user');
 const wait=document.createElement('div');wait.className='m bot';wait.innerHTML='<div class="dots" aria-label="Assistant is typing"><i></i><i></i><i></i></div>';log.appendChild(wait);log.scrollTop=log.scrollHeight;
 await new Promise(r=>setTimeout(r,450+Math.random()*450));
 const a=answer(text);wait.remove();
 history.push({role:'user',content:text},{role:'assistant',content:a});save();
 bubble(a,'bot');speak(a);
 busy=false;sendBtn.disabled=false;input.focus();
}
$('f').addEventListener('submit',e=>{e.preventDefault();const v=input.value;input.value='';input.style.height='auto';ask(v)});
input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('f').requestSubmit()}});
input.addEventListener('input',()=>{input.style.height='auto';input.style.height=Math.min(input.scrollHeight,90)+'px'});
</script>
