<style>
:root{--bg:#0b0506;--panel:#16090b;--maroon:#4a0d17;--burgundy:#7a1427;--crimson:#e11d48;--glow:rgba(225,29,72,.35);--text:#f4e9ea;--muted:#b49a9d;--line:rgba(225,29,72,.22);--r:16px}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:Manrope,system-ui,sans-serif;background:radial-gradient(ellipse at 80% 0%,#2a0810 0%,var(--bg) 55%);color:var(--text);line-height:1.6;min-height:100vh}
a{color:inherit}
:focus-visible{outline:2px solid var(--crimson);outline-offset:3px}
nav{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:14px clamp(16px,5vw,64px);background:rgba(11,5,6,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav b{font-weight:800;letter-spacing:.2px}
nav div{display:flex;gap:20px;font-size:.92rem}
nav a{text-decoration:none;color:var(--muted)}nav a:hover{color:var(--text)}
main{padding:0 clamp(16px,5vw,64px)}
.hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:clamp(16px,3vw,40px);align-items:center;min-height:calc(100vh - 60px);padding:40px 0}
.hero h1{font-size:clamp(2rem,4.2vw,3.4rem);line-height:1.1;font-weight:800;margin-bottom:14px}
.hero p{color:var(--muted);max-width:46ch;margin-bottom:22px}
.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;border:2px solid var(--crimson);box-shadow:0 0 30px var(--glow);margin-bottom:18px;display:block}
.hero>*{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.btn{display:inline-block;padding:11px 20px;border-radius:999px;border:1px solid var(--crimson);background:linear-gradient(135deg,var(--burgundy),var(--maroon));color:#fff;font:700 .95rem Manrope,sans-serif;cursor:pointer;text-decoration:none;box-shadow:0 0 24px var(--glow);transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 0 34px var(--glow)}
.btn.ghost{background:transparent;box-shadow:none;margin-left:8px}
.mascot-wrap{position:relative;display:grid;justify-items:center}
#mascotBtn{background:none;border:0;cursor:pointer;padding:0;width:100%;max-width:300px;animation:float 4.5s ease-in-out infinite;filter:drop-shadow(0 0 28px var(--glow))}
#mascotBtn img{width:100%;height:auto;display:block}
#mascotBtn:hover{filter:drop-shadow(0 0 40px rgba(225,29,72,.6))}
@keyframes float{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-14px) rotate(1deg)}}
.hint{position:absolute;top:-6px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:.82rem;animation:float 4.5s ease-in-out infinite;pointer-events:none}
section{padding:64px 0;border-top:1px solid var(--line)}
section h2{font-size:1.6rem;margin-bottom:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:20px}
.card h3{font-size:1.02rem;margin-bottom:6px}
.card p,.card li{color:var(--muted);font-size:.93rem}
.card ul{padding-left:18px}
.tag{display:inline-block;margin:0 6px 6px 0;padding:4px 12px;border-radius:999px;background:var(--maroon);border:1px solid var(--line);font-size:.85rem}
footer{padding:32px 0 48px;color:var(--muted);font-size:.85rem;text-align:center}
/* chat */
#chat{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:50;width:min(400px,calc(100vw - 32px));height:min(600px,calc(100dvh - 90px));display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--crimson);border-radius:20px;box-shadow:0 0 50px var(--glow),0 20px 60px rgba(0,0,0,.6);overflow:hidden;transform:translateY(20px) scale(.97);opacity:0;visibility:hidden;transition:transform .25s,opacity .25s,visibility .25s}
#chat.open{transform:none;opacity:1;visibility:visible}
.ch{display:flex;align-items:center;gap:10px;padding:12px 14px;background:linear-gradient(135deg,var(--burgundy),var(--maroon));border-bottom:1px solid var(--line)}
.ch img{width:38px;height:34px;object-fit:contain}
.ch strong{flex:1;font-size:.98rem}
.ch button{background:none;border:0;color:var(--text);cursor:pointer;font-size:.82rem;padding:6px 8px;border-radius:8px}
.ch button:hover{background:rgba(255,255,255,.1)}
#log{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
.m{max-width:86%;padding:10px 13px;border-radius:14px;font-size:.93rem;white-space:pre-wrap;word-wrap:break-word}
.m.bot{align-self:flex-start;background:#220d11;border:1px solid var(--line);border-bottom-left-radius:4px}
.m.user{align-self:flex-end;background:linear-gradient(135deg,var(--burgundy),#5c0f1e);border-bottom-right-radius:4px}
.m.err{align-self:flex-start;background:#2a0a0a;border:1px solid #b91c1c;color:#fecaca}
.m.err button{margin-top:8px;display:block;background:#b91c1c;color:#fff;border:0;border-radius:8px;padding:6px 12px;cursor:pointer;font:700 .85rem Manrope,sans-serif}
.dots{display:flex;gap:5px;padding:4px 2px}
.dots i{width:7px;height:7px;border-radius:50%;background:var(--crimson);animation:b 1.1s infinite}
.dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}
@keyframes b{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-4px)}}
#chips{display:flex;flex-wrap:wrap;gap:8px;padding:0 14px 10px}
#chips button{background:transparent;border:1px solid var(--line);color:var(--text);border-radius:999px;padding:6px 12px;font:500 .8rem Manrope,sans-serif;cursor:pointer}
#chips button:hover{background:var(--maroon);border-color:var(--crimson)}
.cf{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--line);background:#120709}
.cf textarea{flex:1;resize:none;max-height:90px;background:#1d0b0f;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:9px 12px;font:inherit;font-size:.93rem}
.cf button{border:0;border-radius:12px;padding:0 16px;background:var(--crimson);color:#fff;font:800 .9rem Manrope,sans-serif;cursor:pointer}
.cf button:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:900px){
 .hero{grid-template-columns:1fr;min-height:0;text-align:left}
 .mascot-wrap{order:3;justify-items:end}
 #mascotBtn{max-width:200px}
 nav div{gap:12px;font-size:.85rem}
 #chat{right:8px;bottom:8px;width:calc(100vw - 16px);height:calc(100dvh - 16px);border-radius:16px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
